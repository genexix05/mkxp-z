x; }

.pointer-arrow::after { background: rgb(0, 167, 255); content: ""; height: =
3px; margin-left: -12px; position: absolute; top: 13.5px; width: 17px; }

.text-section { flex-grow: 1; }

.ad--marquee-vertical-scroll .text-section { display: flex; flex-flow: colu=
mn nowrap; }

.marquee-wrapper { flex-grow: 1; overflow: hidden; position: relative; }

.marquee-wrapper::before { content: "=C2=A0"; }

.marquee { --marquee-horizontal-speed:0; --marquee-horizontal-right-positio=
n:100%; --marquee-vertical-speed:0; --marquee-vertical-speed-initial:0; --m=
arquee-vertical-bottom-position:100%; --marquee-play-state:running; display=
: block; left: 0px; min-width: 100%; position: absolute; top: 0px; }

.ad--marquee-horizontal-scroll .marquee { display: inline-block; white-spac=
e: nowrap; }

.ad--marquee-horizontal-scroll .marquee.marquee--animated { animation-durat=
ion: ; animation-timing-function: ; animation-delay: ; animation-iteration-=
count: ; animation-direction: ; animation-fill-mode: ; animation-name: ; an=
imation-play-state: var(--marquee-play-state),var(--marquee-play-state); }

.ad--marquee-vertical-scroll .marquee.marquee--animated { animation-duratio=
n: ; animation-timing-function: ; animation-delay: ; animation-iteration-co=
unt: ; animation-direction: ; animation-fill-mode: ; animation-name: ; anim=
ation-play-state: var(--marquee-play-state); }

@-webkit-keyframes marquee-horizontal-initial {=20
  0% { transform: translateX(0px); }
  100% { transform: translateX(-100%); }
}

@keyframes marquee-horizontal-initial {=20
  0% { transform: translateX(0px); }
  100% { transform: translateX(-100%); }
}

@-webkit-keyframes marquee-horizontal {=20
  0% { transform: translateX(var(--marquee-horizontal-right-position)); }
  100% { transform: translateX(-100%); }
