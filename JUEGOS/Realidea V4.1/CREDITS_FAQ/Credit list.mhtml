body { min-height: 80px; min-width: 700px; }

.ym-ad-choices { height: 18px; padding: 3px; width: 18px; }

.ad-wrapper { margin: 0px; padding: 0px; }

.advertising-callout { display: none; }

.ad { box-shadow: none; margin: auto; }

.icon { max-height: 100%; }

.ad.icon-tall .icon { max-width: 90px; }

.ad.icon-normal .icon { max-width: 120px; }

.ad.icon-wide .icon { max-width: 172px; }

.flex-container { border: 1px solid rgb(208, 208, 208); display: flex; heig=
ht: 100%; }

.text-section-wrapper { display: flex; flex-grow: 1; margin: 0px 10px; posi=
tion: relative; }

.text-section { margin: auto 0px; max-width: 400px; }

.title { font-size: 18px; line-height: 20px; margin-bottom: 5px; max-width:=
 350px; white-space: nowrap; }

.description, .title { overflow: hidden; text-overflow: ellipsis; }

.description { -webkit-line-clamp: 2; -webkit-box-orient: vertical; display=
: -webkit-box; font-size: 11px; }

.sponsored-by { color: rgb(0, 0, 0); font-size: 7px; left: 0px; line-height=
: 7px; margin: 3px 5px 0px auto; max-width: 148px; overflow: hidden; positi=
on: absolute; text-overflow: ellipsis; top: 3px; white-space: nowrap; }

.ad.has-logo .logo { max-height: 24px; }

.ad.has-logo .title { font-size: 12px; line-height: 12px; margin-bottom: 4p=
x; }

.ad.has-logo .sponsored-by { right: 0px; text-align: right; }

.btn-wrapper { background-color: rgb(0, 167, 255); color: rgb(255, 255, 255=
); display: flex; margin-left: auto; width: 110px; }

.btn-wrapper .btn-content { margin: auto; text-align: center; width: fit-co=
ntent; }

.btn-wrapper .btn-content .btn-text { display: block; font-size: 12px; max-=
width: 105px; overflow: hidden; text-overflow: ellipsis; white-space: nowra=
p; }

.extra-long-characters .text-section-wrapper .text-section, .extra-long-cha=
racters .text-section-wrapper .text-section .title { max-width: none; }

.extra-long-characters .text-section-wrapper .sponsored-by { max-width: 200=
px; }

.extra-long-characters .title { font-size: 15px; line-height: 17px; }

.extra-long-characters .description { -webkit-line-clamp: 3; font-size: 10p=
x; line-height: 12px; }

.extra-long-characters .btn-wrapper .btn-text { white-space: normal; width:=
 110px; }

.extra-long-title:not(.extra-long-characters) .title { font-size: 15px; lin=
e-height: 17px; }
