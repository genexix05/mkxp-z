e: 18px; line-height: 18px; padding: 0px; text-align: center; }

.overlay { background-color: rgba(0, 0, 0, 0.3); color: rgb(255, 255, 255);=
 }

.img { border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.5) 0px 1px 2px 0px; =
